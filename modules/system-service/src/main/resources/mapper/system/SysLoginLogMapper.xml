<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hyl.rock.system.mapper.SysLoginLogMapper">

	<resultMap type="com.hyl.rock.domain.SysLoginLog" id="SysLoginInForResult">
		<id     property="infoId"        column="info_id"           />
		<result property="userName"      column="user_name"         />
		<result property="status"        column="status"            />
		<result property="ipaddr"        column="ipaddr"            />
		<result property="msg"           column="msg"               />
		<result property="accessTime"    column="access_time"       />
	</resultMap>

	<insert id="insertLoginLog" parameterType="com.hyl.rock.domain.SysLoginLog">
		insert into sys_login_log (user_name, status, ipaddr, msg, access_time)
		values (#{userName}, #{status}, #{ipaddr}, #{msg}, sysdate())
	</insert>
	
	<select id="selectLoginLogList" parameterType="com.hyl.rock.system.domain.query.SysLoginLogQuery" resultMap="SysLoginInForResult">
		select info_id, user_name, ipaddr, status, msg, access_time from sys_login_log
		<where>
			<if test="ipaddr != null and ipaddr != ''">
				AND ipaddr like concat('%', #{ipaddr}, '%')
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
			<if test="userName != null and userName != ''">
				AND user_name like concat('%', #{userName}, '%')
			</if>
			<if test="startDate != null and startDate != ''"><!-- 开始时间检索 -->
				AND access_time &gt;= #{startDate}
			</if>
			<if test="endDate != null and endDate != ''"><!-- 结束时间检索 -->
				AND access_time &lt;= #{endDate}
			</if>
		</where>
		order by info_id desc
	</select>
	
	<delete id="deleteLoginLogByIds" parameterType="java.lang.Long">
 		delete from sys_login_log where info_id in
 		<foreach collection="array" item="infoId" open="(" separator="," close=")">
 			#{infoId}
        </foreach> 
 	</delete>
    
    <update id="cleanLoginLog">
        truncate table sys_login_log
    </update>
    
</mapper> 